# DealPilot Environment Configuration

# 1. Database (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/dealpilot?schema=public"

# 2. Redis & BullMQ (Optional in local dev: system falls back to mock Redis automatically)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
USE_MOCK_REDIS="true"

# 3. LLM Provider (For structured deal justifications & summaries)
LLM_PROVIDER="mock" # Options: 'gemini', 'openai', 'mock'
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 4. PayPal Sandbox API (For pre-flight checkout & capture)
PAYPAL_MODE="sandbox" # 'sandbox' | 'live'
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_CLIENT_SECRET="mock_paypal_client_secret"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# 5. App & Server
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
