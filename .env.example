# DealPilot Environment Configuration

# 1. Database
# Local SQLite (zero external dependencies):
# DATABASE_URL="file:./dev.db"
# Docker PostgreSQL 16 (via `docker compose up -d`):
DATABASE_URL="postgresql://dealpilot:dealpilot_password@localhost:5432/dealpilot?schema=public"

# 2. Redis & BullMQ
# When using Docker Redis 7 (via `docker compose up -d`):
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

USE_MOCK_REDIS="false" # Set to "true" for in-memory mock Redis (no Docker needed)

# 3. LLM Provider (Structured Deal Justifications, Specs Summaries & Agent Fallbacks)
LLM_PROVIDER="OPEN_AI"
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-6-luna"

# 4. Channel3 Commerce API (Real-time Multi-Merchant Discovery & Domestic Catalog)
CHANNEL3_API_KEY=""

# 5. PayPal Developer Sandbox & Agent Toolkit (Pre-Flight Checkout & Server-to-Server Capture)
PAYPAL_MODE="sandbox" # 'sandbox' | 'live'
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_CLIENT_SECRET="mock_paypal_client_secret"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# 6. Better Auth (OAuth with Google & GitHub)
BETTER_AUTH_SECRET="dealpilot-secure-better-auth-secret-key-min32chars!"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# 7. Price-Drop Email Notifications (Transactional Outbox)
# If left empty, DealPilot automatically uses its zero-dependency in-app simulated mailer
RESEND_API_KEY=""
EMAIL_FROM="alerts@dealpilot.ai"

# 8. App & Server
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
