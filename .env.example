# DealPilot Environment Configuration

# 1. Database
# Local zero-dependency SQLite:
DATABASE_URL="file:./dev.db"
# Docker PostgreSQL instance (via `docker compose up -d`):
# DATABASE_URL="postgresql://dealpilot:dealpilot_password@localhost:5432/dealpilot?schema=public"

# 2. Redis & BullMQ
# When using Docker Redis (via `docker compose up -d`):
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
USE_MOCK_REDIS="true" # Set to "false" when running Docker Redis

# 3. LLM Provider (For structured deal justifications & summaries)
LLM_PROVIDER="mock" # Options: 'gemini', 'openai', 'mock'
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 4. PayPal Sandbox API (For pre-flight checkout & capture)
PAYPAL_MODE="sandbox" # 'sandbox' | 'live'
PAYPAL_CLIENT_ID="mock_paypal_client_id"
PAYPAL_CLIENT_SECRET="mock_paypal_client_secret"
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"

# 5. App & Server
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
