datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  trackingRules TrackingRule[]
  orders        Order[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Product {
  id                 String             @id @default(uuid())
  canonicalId        String             @unique
  title              String
  brand              String
  model              String
  category           String
  imageUrl           String?
  offers             Offer[]
  trackingRules      TrackingRule[]
  priceObservations  PriceObservation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Offer {
  id                 String             @id @default(uuid())
  productId          String
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceId           String             // e.g. 'amazon', 'bestbuy', 'mock_retailer'
  externalProductId  String
  offerUrl           String
  variantAttributes  String?            // JSON string of { color, storage, condition }
  sellerName         String
  sellerId           String?
  isAuthorizedSeller Boolean            @default(true)
  itemPrice          Float
  shippingPrice      Float              @default(0.0)
  fees               Float              @default(0.0)
  currency           String             @default("INR")
  totalPrice         Float
  availabilityStatus String             @default("in_stock") // 'in_stock' | 'out_of_stock' | 'preorder'
  freshnessStatus    String             @default("fresh")    // 'fresh' | 'stale' | 'unavailable' | 'unknown' | 'error'
  sourceConfidence   Float              @default(1.0)
  lastCheckedAt      DateTime           @default(now())
  observations       PriceObservation[]
  evaluations        DealEvaluation[]
  orders             Order[]
  notifications      NotificationOutbox[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([sourceId, externalProductId])
}

model PriceObservation {
  id            String   @id @default(uuid())
  offerId       String
  offer         Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  itemPrice     Float
  shippingPrice Float    @default(0.0)
  totalPrice    Float
  currency      String   @default("INR")
  observedAt    DateTime @default(now())

  @@index([offerId, observedAt])
  @@index([productId, observedAt])
}

model TrackingRule {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String
  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  offerId             String?
  strategy            String               @default("target_price") // 'target_price' | 'best_deal_by_deadline' | 'near_historical_low'
  targetPrice         Float
  currency            String               @default("INR")
  deadline            DateTime?
  status              String               @default("active") // 'active' | 'paused' | 'triggered' | 'expired'
  nextCheckAt         DateTime             @default(now())
  lastCheckedAt       DateTime?
  lastTriggeredAt     DateTime?
  consecutiveFailures Int                  @default(0)
  pollingPolicy       String               @default("normal") // 'normal' | 'near_target' | 'backoff'
  notifications       NotificationOutbox[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, nextCheckAt])
  @@index([userId])
}

model SearchJob {
  id          String   @id @default(uuid())
  query       String
  budget      Float?
  targetPrice Float?
  status      String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  resultCount Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DealEvaluation {
  id                 String   @id @default(uuid())
  offerId            String
  offer              Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  score              Int      // 0 - 100
  scoreVersion       String   @default("rubric_v1")
  recommendation     String   // 'strong_buy' | 'buy' | 'fair' | 'pass'
  confidenceLevel    String   @default("high") // 'high' | 'medium' | 'provisional'
  signalsJson        String   // JSON string of signals
  missingEvidenceJson String? // JSON string of missing evidence
  explanation        String?
  evaluatedAt        DateTime @default(now())
}

model NotificationOutbox {
  id               String        @id @default(uuid())
  trackingRuleId   String
  trackingRule     TrackingRule  @relation(fields: [trackingRuleId], references: [id], onDelete: Cascade)
  offerId          String
  offer            Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  eventType        String        @default("price_drop") // 'price_drop' | 'target_hit' | 'deadline_deal'
  deduplicationKey String        @unique
  payload          String        // JSON payload of alert details
  status           String        @default("pending") // 'pending' | 'sent' | 'failed' | 'suppressed'
  retryCount       Int           @default(0)
  lastError        String?
  createdAt        DateTime      @default(now())
  processedAt      DateTime?

  @@index([status, createdAt])
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId         String
  offer           Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  quotedTotal     Float
  currency        String        @default("INR")
  status          String        @default("offer_review") // 'offer_review' | 'awaiting_approval' | 'paypal_order_created' | 'capture_pending' | 'paid' | 'failed' | 'expired' | 'cancelled'
  paypalOrderId   String?       @unique
  paypalCaptureId String?       @unique
  transaction     Transaction?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Transaction {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paypalCaptureId String   @unique
  amount          Float
  currency        String   @default("INR")
  status          String   // 'COMPLETED' | 'PENDING' | 'DENIED'
  rawResponse     String?  // JSON string of PayPal capture response
  createdAt       DateTime @default(now())
}

model SourceCheck {
  id            String   @id @default(uuid())
  sourceId      String
  status        String   // 'success' | 'error' | 'timeout' | 'rate_limited'
  latencyMs     Int
  errorCategory String?
  createdAt     DateTime @default(now())

  @@index([sourceId, createdAt])
}
